# Copy this file to .env (already gitignored - see .gitignore's "Secrets / environment"
# section) and fill in real values before running `docker compose up`. These are
# separate from the dev-only values in .NET User Secrets (docs/DECISIONS.md D11) - the
# Docker stack gets its own database and its own JWT signing key, never the developer's
# local ones.

POSTGRES_DB=internship_management
POSTGRES_USER=internship_app
POSTGRES_PASSWORD=change-me

# Must be a long, random string - it signs every JWT the API issues. Generate one with,
# e.g., `openssl rand -base64 32`.
JWT_KEY=change-me-to-a-long-random-string
